{% comment %} 如果客户已登录，传递客户信息 {% endcomment %}
{% if customer %}
  {% assign customer_id = customer.id %}
  {% assign customer_email = customer.email %}
  {% assign customer_params = '&customerId=' | append: customer_id | append: '&customerEmail=' | append: customer_email %}
  {% assign customer_logged_in = true %}
{% else %}
  {% assign customer_params = '' %}
  {% assign customer_logged_in = false %}
{% endif %}

{% comment %} 构建Next.js应用的embed页面URL {% endcomment %}
{% assign app_url = 'https://plugin.ifeedog.com/embed' %}
{% assign pc_url = app_url %}
{% assign mobile_url = app_url %}

<div id="feedobridge-embed-{{ block.id }}" class="feedobridge-embed-container" style="width: 100%; overflow: hidden; position: relative; -webkit-overflow-scrolling: touch; height: 90vh;">
  <iframe 
    id="feedobridge-iframe-{{ block.id }}"
    data-pc-url="{{ pc_url }}"
    data-mobile-url="{{ mobile_url }}"
    data-shop="{{ shop.permanent_domain }}"
    data-customer-logged-in="{{ customer_logged_in }}"
    data-customer-params="{{ customer_params }}"
    src="" 
    style="width: 100%; height: 100%; border: none; min-width: 100vw;" 
    title="FeedoBridge Embed"
    allow="geolocation; microphone; camera; payment; autoplay; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<script>
(function() {
  const iframe = document.getElementById('feedobridge-iframe-{{ block.id }}');
  let redirectFallbackBtn = null;
  const isCustomerLoggedIn = iframe.getAttribute('data-customer-logged-in') === 'true';

  function isAllowedShopifyRedirect(url) {
    try {
      const parsed = new URL(url);
      const host = parsed.hostname;
      return host === 'shopify.com' ||
             host.endsWith('.shopify.com') ||
             host.endsWith('.myshopify.com') ||
             host === 'admin.shopify.com';
    } catch (e) {
      return false;
    }
  }

  function showRedirectFallback(url) {
    if (redirectFallbackBtn) return;
    redirectFallbackBtn = document.createElement('button');
    redirectFallbackBtn.textContent = 'Continue to Shopify Login';
    redirectFallbackBtn.style.position = 'fixed';
    redirectFallbackBtn.style.left = '50%';
    redirectFallbackBtn.style.bottom = '20px';
    redirectFallbackBtn.style.transform = 'translateX(-50%)';
    redirectFallbackBtn.style.zIndex = '999999';
    redirectFallbackBtn.style.padding = '12px 18px';
    redirectFallbackBtn.style.borderRadius = '8px';
    redirectFallbackBtn.style.border = 'none';
    redirectFallbackBtn.style.background = '#111827';
    redirectFallbackBtn.style.color = '#fff';
    redirectFallbackBtn.style.fontSize = '14px';
    redirectFallbackBtn.style.cursor = 'pointer';
    redirectFallbackBtn.addEventListener('click', function() {
      window.top.location.href = url;
    });
    document.body.appendChild(redirectFallbackBtn);
  }

  function logoutShopifyCustomer() {
    try {
      window.top.location.href = '/account/logout';
    } catch (e) {
      window.location.href = '/account/logout';
    }
  }

  function isFromIframeOrigin(event) {
    try {
      if (!iframe.src) return false;
      const allowedOrigin = new URL(iframe.src).origin;
      return event.origin === allowedOrigin;
    } catch (e) {
      return false;
    }
  }

  function sendAuthStateToIframe() {
    if (!iframe || !iframe.src || !iframe.contentWindow) return;

    try {
      const targetOrigin = new URL(iframe.src).origin;
      const authMessage = {
        type: 'SHOPIFY_AUTH_STATE',
        loggedIn: isCustomerLoggedIn,
        customerId: {% if customer %}'{{ customer_id }}'{% else %}null{% endif %},
        customerEmail: {% if customer %}{{ customer_email | json }}{% else %}null{% endif %},
        shopDomain: {{ shop.permanent_domain | json }}
      };

      iframe.contentWindow.postMessage(authMessage, targetOrigin);

      if (!isCustomerLoggedIn) {
        iframe.contentWindow.postMessage(
          {
            type: 'SHOPIFY_CUSTOMER_LOGOUT',
            reason: 'shopify_customer_not_logged_in',
            shopDomain: {{ shop.permanent_domain | json }}
          },
          targetOrigin
        );
      }
    } catch (e) {
      // ignore
    }
  }
  const pcUrl = iframe.getAttribute('data-pc-url');
  const mobileUrl = iframe.getAttribute('data-mobile-url');
  const shopDomain = iframe.getAttribute('data-shop');
  const customerParams = iframe.getAttribute('data-customer-params');
  
  // 检测设备类型
  function isMobileDevice() {
    // 只根据User-Agent判断，不考虑屏幕宽度
    return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  }
  
  // 构建完整URL
  function buildUrl(baseUrl) {
    if (!baseUrl) return '';
    
    const separator = baseUrl.includes('?') ? '&' : '?';
    const deviceType = isMobileDevice() ? 'mobile' : 'desktop';
    const screenWidth = window.innerWidth || document.documentElement.clientWidth;
    const screenHeight = window.innerHeight || document.documentElement.clientHeight;
    
    let fullUrl = baseUrl + separator + 'shop=' + shopDomain 
                  + '&device=' + deviceType
                  + '&platform=shopify'
                  + '&screenWidth=' + screenWidth
                  + '&screenHeight=' + screenHeight;
    
    if (customerParams) {
      fullUrl += customerParams;
    }
    
    return fullUrl;
  }
  
  // 根据设备类型选择URL
  function loadIframe() {
    const isMobile = isMobileDevice();
    const targetUrl = isMobile ? mobileUrl : pcUrl;
    const finalUrl = buildUrl(targetUrl);

    iframe.src = finalUrl;
  }
  
  // 初始加载
  loadIframe();
  
  // 监听窗口大小变化（如果从PC切换到移动视图）
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      const currentSrc = iframe.src;
      const newUrl = buildUrl(isMobileDevice() ? mobileUrl : pcUrl);
      
      // 只在URL变化时重新加载
      if (currentSrc !== newUrl) {
        loadIframe();
      }
    }, 500);
  });

  // 监听 iframe 加载完成
  iframe.addEventListener('load', function() {
    sendAuthStateToIframe();

    // 如果启用了 SSO，发送客户数据
    {% if block.settings.enable_sso and customer %}
    try {
      const targetOrigin = new URL(iframe.src).origin;
      iframe.contentWindow.postMessage({
        type: 'SHOPIFY_CUSTOMER_DATA',
        customerId: '{{ customer_id }}',
        customerEmail: '{{ customer_email }}',
        customerName: '{{ customer.name }}',
        shopDomain: '{{ shop.permanent_domain }}',
        deviceType: isMobileDevice() ? 'mobile' : 'pc'
      }, targetOrigin);
    } catch (e) {
      // ignore
    }
    {% endif %}

    setTimeout(sendAuthStateToIframe, 500);
    setTimeout(sendAuthStateToIframe, 2000);
  });

  window.addEventListener('focus', sendAuthStateToIframe);
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
      sendAuthStateToIframe();
    }
  });

  // 监听来自嵌入网站的消息
  window.addEventListener('message', function(event) {
    if (event.data && (event.data.type === 'FEEDOGO_CUSTOMER_LOGOUT' || event.data.type === 'FEEDOGO_LOGOUT')) {
      if (!isFromIframeOrigin(event)) {
        return;
      }

      logoutShopifyCustomer();
      return;
    }

    if (event.data && event.data.type === 'FEEDOGO_TOP_REDIRECT' && event.data.url) {
      if (!isAllowedShopifyRedirect(event.data.url)) {
        return;
      }

      try {
        window.top.location.href = event.data.url;
      } catch (e) {
        showRedirectFallback(event.data.url);
      }
      return;
    }

    // 验证消息来源
    try {
      if (!isFromIframeOrigin(event)) return;

      // 处理高度调整
      if (event.data.type === 'RESIZE' && event.data.height) {
        iframe.style.height = event.data.height + 'px';
      }

      // 处理 SSO 成功回调
      if (event.data.type === 'SSO_SUCCESS') {
      }
    } catch (e) {
      // 忽略无效消息
    }
  });
})();
</script>

<style>
.feedobridge-embed-container {
  margin: 0;
  padding: 0;
  width: 100vw !important;
  height: 90vh !important;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}

.feedobridge-embed-container iframe {
  width: 100% !important;
  height: 100% !important;
}

@media (max-width: 768px) {
  .feedobridge-embed-container {
    height: 90vh !important;
  }
}
</style>

{% schema %}
{
  "name": "FeedoBridge Embed",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sso",
      "label": "启用单点登录 (SSO)",
      "info": "启用后会自动传递客户信息到嵌入的网站",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "此扩展会自动加载 FeedoBridge 应用，并处理用户登录。无需手动配置URL。"
    }
  ]
}
{% endschema %}
